+static void emac0_phy_select(phy_interface_t interface)
+{
+	u32 value;
+	void *addr;
+
+	addr = (void *)(EMAC0_MM_REG);
+	value = readl(addr);
+
+	if (interface == PHY_INTERFACE_MODE_RGMII)
+	{
+		value |= (0x1 << EMAC0_PHY_IF_SEL);
+		//printf("EMAC0: select RGMII mode\n");
+	}
+	else if (interface == PHY_INTERFACE_MODE_RMII)
+	{
+		value &= (~(0x1 << EMAC0_PHY_IF_SEL));
+		//printf("EMAC0: select RMII mode\n");
+	}
+	else if (interface == PHY_INTERFACE_MODE_GMII)
+	{
+		printf("EMAC0: select GMII mode for haps\n");
+		return;
+	}
+	else
+	{
+		printf("EMAC0: don't support this phy interface\n");
+		return;
+	}
+
+	writel(value, addr);
+
+}
+
+static void emac1_phy_select(phy_interface_t interface)
+{
+	u32 value;
+	void *addr;
+
+	addr = (void *)(EMAC1_PP_REG);
+	value = readl(addr);
+
+	if (interface == PHY_INTERFACE_MODE_RGMII)
+	{
+		value |= (0x1 << EMAC1_PHY_IF_SEL);
+		//printk("EMAC1: select RGMII mode\n");
+	}
+	else if (interface == PHY_INTERFACE_MODE_RMII)
+	{
+		value &= (~(0x1 << EMAC1_PHY_IF_SEL));
+		//printk("EMAC1: select RMII mode\n");
+	}
+	else if (interface == PHY_INTERFACE_MODE_GMII)
+	{
+		printk("EMAC1: select GMII mode for haps\n");
+		return;
+	}
+	else
+	{
+		printk("EMAC1: don't support this phy interface\n");
+		return;
+	}
+
+	writel(value, addr);
+
+}
