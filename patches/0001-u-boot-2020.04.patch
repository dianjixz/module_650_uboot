+static int eip130_sha256_init(char *data, char *output, int size)
+{
+	char *ptr;
+	int i;
+	int ret;
+	hash_token[2] = size;
+	hash_token[5] = size;
+	hash_token[6] = 0x23;
+	hash_token[24] = 0;
+	hash_token[3] = (unsigned long) data & 0xFFFFFFFF;
+	hash_token[4] = (unsigned int)(((unsigned long)data >> 32) & 0xFFFFFFFF);
