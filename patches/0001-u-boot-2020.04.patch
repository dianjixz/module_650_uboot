+static void emac_sw_rst(int bus_id)
+{
+	u32 value;
+	void *addr;
+	unsigned char emac_rst;
+
+	if (bus_id == EMAC0)
+	{
+		//printf("reset EMAC0...\n");
+		addr = (void *)(EMAC0_MM_SW_RST0);
+		emac_rst = EMAC0_SW_RST;
+	}
+	else if (bus_id == EMAC1)
+	{
+		//printf("reset EMAC1...\n");
+		addr = (void *)(EMAC1_PP_SW_RST0);
+		emac_rst = EMAC1_SW_RST;
+	}
+	else
+	{
+		printf("EMAC:only support EMAC0 and EMAC1 reset\n");
+		return;
+	}
+
+	value = readl(addr);
+	value |= (0x1 << emac_rst);
+	writel(value, addr);
+
+#ifdef CONFIG_AXERA_EMAC_HAPS
+	delay_ms(50);
+#else
+	mdelay(50); //20
+#endif
+
+	value = readl(addr);
+	value &= (~(0x1 << emac_rst));
+	writel(value, addr);
+
+#ifdef CONFIG_AXERA_EMAC_HAPS
+	delay_ms(50);
+#else
+	mdelay(50);
+#endif
+}
