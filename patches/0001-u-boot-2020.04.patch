+static inline void vo_writel(void __iomem *regs, u32 offset, u32 val)
+{
+	writel_relaxed(val, regs + offset);
+}
+
+static inline u32 vo_readl(void __iomem *regs, u32 offset)
+{
+	return readl_relaxed(regs + offset);
+}
+
+#endif
