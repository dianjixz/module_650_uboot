+static int SAMPLE_CIPHER_HashSingle(void)
+{
+    int i;
+    AX_CIPHER_HASH_CTL_S hashCtl;
+    HASH_Vector *tv_p;
+    AX_CIPHER_HANDLE handle;
+    AX_U8 digest[512 / 8];
+    AX_S32 ret;
