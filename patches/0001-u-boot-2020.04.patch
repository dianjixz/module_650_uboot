+		       emmc_ctrl_reg_buf[i * 4 + 2], emmc_ctrl_reg_buf[i * 4 + 3]);
+	}
+	for (i = 0; i < SDPHY_REG_NUM / 4; i++) {
+		printf("%lX ++ %04X: %08X %08X %08X %08X\n", (ulong)host->ioaddr, SDHCI_AXERA_PHY_BASE + i * 0x10,
