index 00000000..554b7fba
--- /dev/null
+++ b/cmd/axera/cipher/eip130_drv.c
@@ -0,0 +1,413 @@
+/**************************************************************************************************
+ *
+ * Copyright (c) 2019-2024 Axera Semiconductor Co., Ltd. All Rights Reserved.
+ *
