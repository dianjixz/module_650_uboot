+static void print_boot_reason(void)
+{
+	u32 tmp;
+	tmp = axera_get_boot_reason();
+	printf("boot_reason:%d\n",tmp);
+	if (tmp & (1 << 4)) {
+		printf("wdt4 reset\n!");
+	}
+	if (tmp & (1 << 3)) {
+		printf("wdt0 reset\n!");
+	}
+	if (tmp & (1 << 1)) {
+		printf("thm reset\n!");
+	}
+	if (tmp & (1 << 0)) {
+		printf("swrst reset\n!");
+	}
+}
