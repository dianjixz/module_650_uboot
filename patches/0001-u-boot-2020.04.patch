+		ret = -1; //temp
+		break;
+	case STORAGE_TYPE_SSD:
+		ret = usb_stor_update_to_ssd(pfile, len);
+		break;
+	default:
+		ret = -1;
+		break;
+	}
+
+	return ret;
+}
