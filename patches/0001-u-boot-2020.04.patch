+	dump_reason = abort_status;
+	/*clear abort alarm status */
+	abort_cfg =
+	    ABORT_WDT0_CLR | ABORT_THM_CLR | ABORT_SWRST_CLR;
+	writel(abort_cfg, COMM_ABORT_CFG);
+	/*enable watchdog, thermal abort function */
+	abort_cfg = ABORT_WDT0_EN | ABORT_THM_EN;
+	writel(abort_cfg, COMM_ABORT_CFG);
+	return abort_status;
+}
