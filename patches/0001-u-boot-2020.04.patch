+			env_set("bootcmd", "usb_storage_update");
+			wdt0_enable(0);
+			printf("env usbupdate is %s, enter usb update mode\n", update_status);
+			boot_info_data.mode = USB_STOR_MODE;
+			return USB_STOR_MODE;
