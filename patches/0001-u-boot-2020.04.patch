+#define	PCI_BASE_ADDRESS_MEM_TYPE_64	0x04	/* 64 bit address */
+#define	PCI_BASE_ADDRESS_MEM_PREFETCH	0x08	/* prefetchable? */
+
+#define DBI_CS2			0x100000
