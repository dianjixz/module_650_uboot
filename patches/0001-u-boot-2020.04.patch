+static u32 calc_image_checkSum(u8 * buf, u32 len)
+{
+	u32 chkSum = 0;
+	u32 aligned = (len & ~0x3);
+	u32 remaining = (len & 0x3);
+
+	for (int i = 0; i < aligned / sizeof(u32); i++) {
+		chkSum += ((u32 *) buf)[i];
+	}
+
+	for (int i = 0; i < remaining; i++) {
+		chkSum += *(buf + aligned + i);
+	}
+
+	return chkSum;
+}
