+U_BOOT_DRIVER(sdhci_axera) = {
+	.name = "sdhci-axera",.id = UCLASS_MMC,.of_match = sdhci_axera_match,.bind = sdhci_axera_bind,.probe =
+	sdhci_axera_probe,.priv_auto_alloc_size = sizeof(struct sdhci_host),.platdata_auto_alloc_size =
