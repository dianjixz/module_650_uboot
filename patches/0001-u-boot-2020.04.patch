+u32 fdl_checksum32(u32 chksum, u8 const *pdata, u32 len)
+{
+	u32 i;
+
+	for (i = 0; i < len; i++) {
+		chksum += (u8) (*(pdata + i));
+	}
+
+	return chksum;
