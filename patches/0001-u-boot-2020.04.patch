+/* PHY_CNFG */
+#define BITS_PHY_CNFG_PAD_SN(x)       (((x) & 0xF) << 20)
+#define BITS_PHY_CNFG_PAD_SP(x)       (((x) & 0xF) << 16)
+#define BIT_PHY_CNFG_PHY_PWRGOOD       BIT(1)
