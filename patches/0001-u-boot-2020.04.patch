+static void emac0_clk_init(void)
+{
+	u32 value;
+	void *addr;
+
+	//printf("configure EMAC0 clk...\n");
+
+	/* enable aclk & pclk */
+	addr = (void *)(EMAC0_MM_CLK_EB1);
+	value = readl(addr);
+	value |= (0x1 << EMAC0_ACLK);
+	writel(value, addr);
+
+	/* enable ephy ref */
+	addr = (void *)(EMAC_EPHY_REF_EB);
+	value = readl(addr);
+	//if ((value>>9) & 0x1 == 0x0)
+	value |= (0x1 << 9);
+	writel(value, addr);
+
+	/* enable rgmii tx clk */
+	addr =  (void *)(EMAC0_MM_CLK_EB0);
+	value = readl(addr);
+	value |= (0x1 << EMAC0_RGMII_TX_EB);
+	writel(value, addr);
+
+	/* configure rmii clk */
+	addr = (void *)(EMAC1_PP_CLK_EB0);
+	value = readl(addr);
+	value |= (0x1 << EMAC0_RMII_RX_EB);	/* enable rmii rx clk */
+	if (0)
+	{
+		value |= (0x1 << EMAC0_RMII_PHY_EB);	/* RMII CLK: MAC -> PHY */
+	}
+	else
+	{
+		value &= ~(0x1 << EMAC0_RMII_PHY_EB);	/* RMII CLK: PHY -> MAC */
+	}
+	writel(value, addr);
+}
+
+static void emac1_clk_init(void)
+{
+	u32 value;
+	void *addr;
+
+	//printf("configure EMAC1 clk...\n");
+
+	/* enable aclk & pclk */
+	addr = (void *)(EMAC1_PP_CLK_EB1);
+	value = readl(addr);
+	value |= (0x1 << EMAC1_ACLK);
+	writel(value, addr);
+
+	/* enable ephy ref */
+	addr = (void *)(EMAC_EPHY_REF_EB);
+	value = readl(addr);
+	//if ((value>>9) & 0x1 == 0x0)
+	value |= (0x1 << 9);
+	writel(value, addr);
+
+	/* enable rgmii tx clk */
+	addr = (void *)(EMAC1_PP_CLK_EB0);
+	value = readl(addr);
+	value |= (0x1 << EMAC1_RGMII_TX_EB);
+	writel(value, addr);
+
+	/* configure rmii clk */
+	addr = (void *)(EMAC1_PP_CLK_EB0);
+	value = readl(addr);
+	value |= (0x1 << EMAC1_RMII_RX_EB);	/* enable rmii rx clk */
+	if (0)
+	{
+		value |= (0x1 << EMAC1_RMII_PHY_EB);	/* RMII CLK: MAC -> PHY */
+	}
+	else
+	{
+		value &= ~(0x1 << EMAC1_RMII_PHY_EB);	/* RMII CLK: PHY -> MAC */
+	}
+	writel(value, addr);
+}
