+#define EFSC_SHADOW_9  (0x7C)
+#define EFSC_SHADOW_10 (0x80)
+#define EFSC_SHADOW_11 (0x84)
+#define EFSC_SHADOW_12 (0x88)
+#define EFSC_SHADOW_13 (0x8C)
+#define EFSC_SHADOW_14 (0x90)
+#define EFSC_SHADOW_15 (0x94)
