+static int rtl9010_modify_changed(struct phy_device *phydev, u32 regnum, u16 mask, u16 set)
+{
+	int ret;
+	int new;
+	ret = phy_write(phydev, MDIO_DEVAD_NONE, 0x1b, regnum);
+	ret = phy_read(phydev, MDIO_DEVAD_NONE, 0x1c);
+	if (ret < 0)
+		return ret;
+	new = (ret & ~mask) | set;
+	if (new == ret)
+		return ret;
+	return phy_write(phydev, MDIO_DEVAD_NONE, 0x1c, new);
+}
+
+static int rtl9010_config(struct phy_device *phydev)
+{
+	unsigned int reg;
+	int is_master = 0;
+	int ret;
+
+	printf("rtl9010 config\n");
+
+	phydev->autoneg = AUTONEG_DISABLE;
+	phydev->speed = SPEED_1000;
+	phydev->duplex = DUPLEX_FULL;
+
+#ifdef CONFIG_DM_ETH
+	if (dev_read_bool(phydev->dev, "realtek,as-master")) {
+		is_master = CTL1000_AS_MASTER;
+	}
+#endif
+	// slave/master mode
+	reg = phy_read(phydev, MDIO_DEVAD_NONE, MII_CTRL1000);
+	reg &=  ~(CTL1000_AS_MASTER);
+	reg =  reg | is_master | CTL1000_ENABLE_MASTER;
+	phy_write(phydev, MDIO_DEVAD_NONE, MII_CTRL1000, reg);
+
+	// config tx/rx delay for rgmii
+	if (phydev->interface == PHY_INTERFACE_MODE_RGMII) {
+		ret = rtl9010_modify_changed(phydev, 0xd084, BIT(7), 0);
+		ret |= rtl9010_modify_changed(phydev, 0xd082, BIT(0) | BIT(1), BIT(0) | BIT(1));
+		ret |= rtl9010_modify_changed(phydev, 0xd084, BIT(14) | BIT(15), RTL9010_TX_DELAY);
+		ret |= rtl9010_modify_changed(phydev, 0xd084, BIT(0) | BIT(1) | BIT(2), BIT(0) | BIT(1) | BIT(2));
+		ret |= rtl9010_modify_changed(phydev, 0xd084, BIT(0) | BIT(1) | BIT(2), 0);
+		ret |= rtl9010_modify_changed(phydev, 0xd082, BIT(0) | BIT(1), BIT(0) | BIT(1));
+		ret |= rtl9010_modify_changed(phydev, 0xd084, BIT(0) | BIT(1) | BIT(2), BIT(0) | BIT(1) | BIT(2));
+		if (ret < 0) {
+			printf("Failed to update the TX delay register\n");
+			return ret;
+		}
+		ret = rtl9010_modify_changed(phydev, 0xd04a, RTL9010_RX_DELAY, RTL9010_RX_DELAY);
+		if (ret < 0) {
+			printf("Failed to update the RX delay register\n");
+			return ret;
+		}
+		ret = phy_reset(phydev);
+		mdelay(200);
+	}
+
+	// disable AN
+	reg = phy_read(phydev, MDIO_DEVAD_NONE, MII_BMCR);
+	reg &=  ~(BMCR_ANENABLE);
+	phy_write(phydev, MDIO_DEVAD_NONE, MII_BMCR, reg);
+
+	/* close spread spectrum */
+	ret = rtl9010_modify_changed(phydev, 0xd012, BIT(0) | BIT(2), 0);
+	if (ret < 0) {
+		printf("Failed to close spread spectrum\n");
+		return ret;
+	}
+
+	ret = genphy_config_aneg(phydev);
+	ret |= phy_reset(phydev);
+	mdelay(200);
+
+	return ret;
+}
