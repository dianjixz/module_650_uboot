+#define SDHCI_AXERA_PHY_RSTNPAD_CNFG   (0x0C + SDHCI_AXERA_PHY_BASE)
+#define SDHCI_AXERA_PHY_COMMDL_CNFG    (0x1C + SDHCI_AXERA_PHY_BASE)
+#define SDHCI_AXERA_PHY_SDCLKDL_CNFG   (0x1D + SDHCI_AXERA_PHY_BASE)
