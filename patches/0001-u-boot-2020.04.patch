+static boot_mode_t usb_update_mode(void)
+{
+	if (boot_info_data.mode == USB_UPDATE_MODE) {
+		env_set("bootdelay", "0");
+		env_set("bootcmd", "download");
+		printf("enter usb download mode\n");
+		wdt0_enable(0);
+		return USB_UPDATE_MODE;
+	}
+	return CMD_UNDEFINED_MODE;
+}
