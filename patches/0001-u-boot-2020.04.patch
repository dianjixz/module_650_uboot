+int do_pwm(cmd_tbl_t *cmdtp, int flag, int argc, char * const argv[])
+{
+    struct udevice *dev;
+    uint dev_number = 0;
+    uint chan_number = 0;
+    uint period = 0;
+    uint duty = 0;
+
+    if (argc < 5) {
+        debug("usage: pwm <device number(start with 0)> \
+                <channel number(start with 0)> <period> <duty>\n");
+        return -1;
+    }
