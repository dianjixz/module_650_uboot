+#define EIP130TOKEN_OPCODE_SYSTEM                 15U
+
+// Token sub codes
+// TRNG operations
+#define EIP130TOKEN_SUBCODE_RANDOMNUMBER          0U
+#define EIP130TOKEN_SUBCODE_TRNGCONFIG            1U
+#define EIP130TOKEN_SUBCODE_VERIFYDRBG            2U
+#define EIP130TOKEN_SUBCODE_VERIFYNRBG            3U
